#!/bin/bash
# fetch - Slackware package manager
# Author: simargl <https://github.com/simargl>
# License: GPL v3

VERSION="14.2"
MAIN_MIRROR="https://mirror.de.leaseweb.net/slackware/slackware64-$VERSION"
OTHER_MIRRORS=(
    "https://download.salixos.org/x86_64/$VERSION"
    "https://download.salixos.org/x86_64/extra-$VERSION"
)
DBPATH="/var/lib/slackware"
CACHEDIR="/var/cache/slackware"

# Ensure directories exist
mkdir -p "$DBPATH" "$CACHEDIR"

# Root check
if [[ $EUID -ne 0 ]]; then
    printf "Error: This script must be run as root\n" >&2
    exit 1
fi

# Colors
if [ -t 1 ]; then
    RESET='\033[0m'; BOLD='\033[1m'; DIM='\033[2m'
    RED='\033[31m'; GREEN='\033[32m'; YELLOW='\033[33m'; CYAN='\033[36m'
    BRIGHT_GREEN='\033[92m'; BRIGHT_YELLOW='\033[93m'; BRIGHT_RED='\033[91m'
else
    RESET=''; BOLD=''; DIM=''; RED=''; GREEN=''; YELLOW=''; CYAN=''
    BRIGHT_GREEN=''; BRIGHT_YELLOW=''; BRIGHT_RED=''
fi

# UI
ui_section() { printf "\n${BOLD}::${RESET} ${BOLD}%s${RESET}\n" "$1"; }
ui_error() { printf "${BRIGHT_RED}${BOLD}error:${RESET} %s\n" "$1" >&2; }
ui_warning() { printf "${BRIGHT_YELLOW}${BOLD}warning:${RESET} %s\n" "$1"; }

# Repository
fn_download_file() {
    printf " %s" "$3"
    wget -q -nv --no-check-certificate "$1" -P "$2"
    printf " ${BRIGHT_GREEN}done${RESET}\n"
}

fn_repo_update() {
    [ -f "$DBPATH/packages.db" ] && rm -f "$DBPATH/packages.db"
    ui_section "Synchronizing package databases..."
    printf " ${BOLD}Slackware $VERSION${RESET}\n"
    
    for i in extra patches; do
        TMP_DIR=$(mktemp -d)
        fn_download_file "$MAIN_MIRROR/$i/PACKAGES.TXT" "$TMP_DIR" "$i"
        if [ -f "$TMP_DIR/PACKAGES.TXT" ]; then
            extract_package_info "$MAIN_MIRROR" "$TMP_DIR/PACKAGES.TXT" >> "$DBPATH/packages.db"
        fi
        rm -rf "$TMP_DIR"
    done
    
    TMP_DIR=$(mktemp -d)
    fn_download_file "$MAIN_MIRROR/PACKAGES.TXT" "$TMP_DIR" "core"
    if [ -f "$TMP_DIR/PACKAGES.TXT" ]; then
        extract_package_info "$MAIN_MIRROR" "$TMP_DIR/PACKAGES.TXT" >> "$DBPATH/packages.db"
    fi
    rm -rf "$TMP_DIR"

    printf "\n ${BOLD}Salix${RESET}\n"
    for repo_url in "${OTHER_MIRRORS[@]}"; do
        repo_name="$(basename "$repo_url")"
        printf " %s" "$repo_name"
        TMP_DIR=$(mktemp -d)
        wget -q -nv --no-check-certificate "$repo_url/PACKAGES.TXT" -P "$TMP_DIR"
        if [ -f "$TMP_DIR/PACKAGES.TXT" ]; then
            extract_package_info "$repo_url" "$TMP_DIR/PACKAGES.TXT" >> "$DBPATH/packages.db"
            printf " ${BRIGHT_GREEN}done${RESET}\n"
        else
            printf " ${BRIGHT_YELLOW}failed${RESET}\n"
        fi
        rm -rf "$TMP_DIR"
    done

    if [ -f "$DBPATH/packages.db" ]; then
        PACKAGE_COUNT="$(grep -c ^ "$DBPATH/packages.db")"
    else
        PACKAGE_COUNT=0
    fi
    printf "\n${BOLD}::${RESET} Synchronization complete ${DIM}(%s packages)${RESET}\n" "$PACKAGE_COUNT"
}

extract_package_info() {
awk -v mirror="$1" '
BEGIN { FS=": "; OFS="|"; url=""; description="" }
/^PACKAGE NAME:/ {
    package_name=$2
    gsub(/^[ \t]+|[ \t]+$/,"",package_name)
}
/^PACKAGE LOCATION:/ {
    gsub(/^[ \t]+|[ \t]+$/,"",$2)
    gsub(/^\./,"",$2)
    url=mirror "/" $2 "/" package_name
}
/^PACKAGE DESCRIPTION:/ {
    getline
    description=$0
    sub(/^.*: /,"",description)
}
/^$/ {
    if(package_name!="" && url!="") print url,description
    url=""; description=""
}
END {
    if(package_name!="" && url!="") print url,description
}' "$2"
}

# Search
fn_pkg_search_print_out() {
    local e_url="$1"
    local e_filename="${e_url##*/}"
    local e_base="${e_filename%.t?z}"
    local e_release="${e_base##*-}"
    local e_temp="${e_base%-*}"
    local e_arch="${e_temp##*-}"
    local e_temp="${e_temp%-*}"
    local e_version="${e_temp##*-}"
    local e_name="${e_temp%-*}"
    local e_desc
    e_desc="$(echo "$2" | sed "s/$e_name //g")"
    local status=""
    
    if [ -d "$DBPATH/installed/$e_name" ] && [ -f "$DBPATH/installed/$e_name/pkginfo" ]; then
        # shellcheck source=/dev/null
        source "$DBPATH/installed/$e_name/pkginfo"
        if [ "$pkgver" = "$e_version" ] && [ "$pkgrel" = "$e_release" ]; then
            status=" ${BRIGHT_GREEN}[installed]${RESET}"
        fi
    fi
    printf " ${BOLD}%s${RESET} %s-%s %s%b\n" "$e_name" "$e_version" "$e_release" "$e_arch" "$status"
    local e_desc_no_braces
    e_desc_no_braces="$(echo "$e_desc" | sed 's/[()]//g')"
    printf "    ${DIM}%s${RESET}\n\n" "$e_desc_no_braces"
}

fn_pkg_search() {
    if [[ -n "$ARG" ]]; then
        if [ ! -f "$DBPATH/packages.db" ]; then
            ui_error "Package database missing. Please run 'fetch up' first."
            exit 1
        fi
        local PKGSEARCH
        PKGSEARCH=$(grep -i "$ARG" "$DBPATH/packages.db")
        ui_section "Searching for $ARG..."
        if [[ -n "$PKGSEARCH" ]]; then
            local count=0
            while IFS= read -r result; do
                local urlR descriptionR
                urlR="$(echo "$result" | cut -d '|' -f1)"
                descriptionR="$(echo "$result" | cut -d '|' -f2)"
                fn_pkg_search_print_out "$urlR" "$descriptionR"
                count=$((count+1))
            done <<< "$PKGSEARCH"
            printf "${BOLD}::${RESET} %s package%s found\n" "$count" "$([ "$count" -eq 1 ] && echo "" || echo "s")"
        else
            ui_error "No results found for '$ARG'"
        fi
    else
        ui_warning "Please provide a search term."
    fi
}

fn_get_pkgmatch() {
    [ -f "$DBPATH/packages.db" ] && grep -m1 "/$1-[0-9]" "$DBPATH/packages.db" | cut -d '|' -f1
}

fn_check_pkgmatch_exists() {
    local missing=()
    for ONE in "$@"; do
        local pkgmatch
        pkgmatch="$(fn_get_pkgmatch "$ONE")"
        if [[ -z "$pkgmatch" ]]; then
            missing+=("$ONE")
        fi
    done
    if [[ ${#missing[@]} -ne 0 ]]; then
        for i in "${missing[@]}"; do
            ui_error "Unable to locate package $i"
        done
        exit 1
    fi
}

# Download
fn_pkg_download() {
    if [[ -n "$ARG" ]]; then
        local pkgmatch
        pkgmatch="$(fn_get_pkgmatch "$ARG")"
        if [[ -n "$pkgmatch" ]]; then
            local file
            file="$(basename "$pkgmatch")"
            if [ ! -f "$CACHEDIR/$file" ]; then
                printf " %s" "$file"
                wget -q -nv --no-check-certificate "$pkgmatch" -P "$CACHEDIR"
                if [ ! -f "$CACHEDIR/$file" ]; then
                    printf " ${BRIGHT_RED}failed${RESET}\n"
                    ui_error "$file download failed"
                    exit 1
                fi
                printf " ${BRIGHT_GREEN}done${RESET}\n"
            else
                printf " %s ${DIM}[cached]${RESET}\n" "$file"
            fi
        else
            ui_error "Unable to locate package $ARG"
        fi
    fi
}

fn_pkg_download_all() {
    fn_check_pkgmatch_exists "$@"
    local max_parallel=7
    local current_jobs=0
    for pkg in "$@"; do
        ARG="$pkg"
        fn_pkg_download &
        current_jobs=$((current_jobs+1))
        if [ "$current_jobs" -ge "$max_parallel" ]; then
            wait -n
            current_jobs=$((current_jobs-1))
        fi
    done
    wait
}

# Metadata
fn_write_metadata() {
    local pkgfile="$1"
    local destroot="$2"
    local nv
    nv="$(basename "$pkgfile" | sed 's/\(.*\)-[^-]*-[^-]*$/\1/')"
    local pkgname
    pkgname="$(echo "$nv" | sed 's/-[^-]*$//')"
    local pkgver
    pkgver="$(echo "$nv" | sed 's/.*-//')"
    local pkgrel
    pkgrel="$(echo "${pkgfile##*-}" | sed 's/\.t[glx]z//')"
    
    mkdir -p "$destroot/$DBPATH/installed/$pkgname"
    {
        echo "pkgname=$pkgname"
        echo "pkgver=$pkgver"
        echo "pkgrel=$pkgrel"
    } > "$destroot/$DBPATH/installed/$pkgname/pkginfo"
    
    tar -tvf "$pkgfile" | awk '!/^d/ {print $NF}' | grep -v "^install/" | sed 's/^/\//' > "$destroot/$DBPATH/installed/$pkgname/files"
}

# Extract Single
fn_pkg_extract() {
    if [[ -n "$ARG" && -f "$ARG" ]]; then
        ui_section "Extracting package..."
        printf " %s" "$(basename "$ARG")"
        tar -xf "$ARG"
        printf " ${BRIGHT_GREEN}done${RESET}\n"
    else
        ui_error "Extraction failed: File not found or invalid."
        exit 1
    fi
}

# Extract All (Restored to original behavior using 'install' folder)
fn_pkg_extract_all() {
    ui_section "Extracting packages..."
    for i in *.t?z; do
        [[ -e "$i" ]] || break
        ARG="$i"
        printf " %s" "$ARG"
        [ ! -d install ] && mkdir install
        tar -xf "$ARG" -C install
        if [ -f "install/install/doinst.sh" ]; then
            cd install && sh ./install/doinst.sh 2>/dev/null
            cd "$OLDPWD" || exit
        fi
        fn_write_metadata "$ARG" install
        [ -d install/install ] && rm -r install/install
        printf " ${BRIGHT_GREEN}done${RESET}\n"
    done
}

# Post-install
fn_pkg_post_actions() {
    local ICONS DESKTOP GSETTINGS FONTS
    if [ -f "$DBPATH/installed/$pkgname/files" ]; then
        ICONS=$(grep -q /usr/share/icons/hicolor "$DBPATH/installed/$pkgname/files" && echo "icons" || true)
        DESKTOP=$(grep -q /usr/share/applications "$DBPATH/installed/$pkgname/files" && echo "desktop" || true)
        GSETTINGS=$(grep -q /usr/share/glib-2.0/schemas "$DBPATH/installed/$pkgname/files" && echo "gsettings" || true)
        FONTS=$(grep -q /usr/share/fonts/TTF "$DBPATH/installed/$pkgname/files" && echo "fonts" || true)
        
        [ -n "$ICONS" ] && { printf "  updating icon cache..."; gtk-update-icon-cache /usr/share/icons/hicolor >/dev/null 2>&1; printf " ${BRIGHT_GREEN}done${RESET}\n"; }
        [ -n "$DESKTOP" ] && { printf "  updating desktop database..."; update-desktop-database >/dev/null 2>&1; printf " ${BRIGHT_GREEN}done${RESET}\n"; }
        [ -n "$GSETTINGS" ] && { printf "  compiling GSettings schemas..."; glib-compile-schemas /usr/share/glib-2.0/schemas >/dev/null 2>&1; printf " ${BRIGHT_GREEN}done${RESET}\n"; }
        [ -n "$FONTS" ] && { printf "  updating font cache..."; fc-cache -f -s >/dev/null 2>&1; mkfontscale /usr/share/fonts/TTF >/dev/null 2>&1; mkfontdir /usr/share/fonts/TTF >/dev/null 2>&1; printf " ${BRIGHT_GREEN}done${RESET}\n"; }
    fi
}

fn_run_install_script() {
    if [ -f "$1" ]; then
        (cd / && sh "$1" >/dev/null 2>&1)
    fi
}

fn_cleanup_install_directory() {
    [ -d /install ] && rm -rf /install
}

# Install
fn_pkg_install_local() {
    local target_file="$1"
    if [[ -n "$target_file" && -f "$target_file" ]]; then
        local PACKAGE_FILE="$(basename "$target_file")"
        local PACKAGE_BASE="${PACKAGE_FILE%.t?z}"
        local PACKAGE_RELEASE="${PACKAGE_BASE##*-}"
        local PACKAGE_TEMP="${PACKAGE_BASE%-*}"
        local PACKAGE_ARCH="${PACKAGE_TEMP##*-}"
        local PACKAGE_TEMP="${PACKAGE_TEMP%-*}"
        local PACKAGE_VERSION="${PACKAGE_TEMP##*-}"
        local PACKAGE_NAME="${PACKAGE_TEMP%-*}"
        
        printf " %s %s-%s %s\n" "$PACKAGE_NAME" "$PACKAGE_VERSION" "$PACKAGE_RELEASE" "$PACKAGE_ARCH"
        tar -xf "$target_file" -C /
        fn_run_install_script "/install/doinst.sh"
        fn_write_metadata "$target_file" /
        fn_cleanup_install_directory
        pkgname="$PACKAGE_NAME"
        fn_pkg_post_actions
    else
        ui_error "Installation failed: File not found or invalid."
        exit 1
    fi
}

fn_pkg_install() {
    local local_install=false
    for ONE in "$@"; do
        if [ -f "$ONE" ]; then
            local_install=true
            local name
            name="$(basename "$ONE" | sed 's/\(.*\)-[^-]*-[^-]*$/\1/' | sed 's/-[^-]*$//')"
            if [ -d "$DBPATH/installed/$name" ]; then
                ui_warning "$ONE is already installed"
            else
                ui_section "Installing package..."
                fn_pkg_install_local "$ONE"
            fi
        fi
    done
    if [ "$local_install" = true ]; then exit 0; fi

    fn_check_pkgmatch_exists "$@"
    for ONE in "$@"; do
        if [ -d "$DBPATH/installed/$ONE" ]; then
            ui_warning "$ONE is already installed"
            exit 1
        fi
    done

    ui_section "Downloading packages..."
    fn_pkg_download_all "$@"
    
    printf "\n${BOLD}::${RESET} Installing packages...\n"
    for ONE in "$@"; do
        local pkgmatch
        pkgmatch="$(fn_get_pkgmatch "$ONE")"
        local file
        file="$(basename "$pkgmatch")"
        if [ -f "$CACHEDIR/$file" ]; then
            fn_pkg_install_local "$CACHEDIR/$file"
        fi
    done
    printf "\n${BOLD}::${RESET} ${BRIGHT_GREEN}Installation complete${RESET}\n"
}

# Remove
fn_pkg_remove() {
    ui_section "Removing packages..."
    for i in "$@"; do
        if [ -f "$DBPATH/installed/$i/pkginfo" ]; then
            # shellcheck source=/dev/null
            source "$DBPATH/installed/$i/pkginfo"
            printf " %s %s-%s\n" "$i" "$pkgver" "$pkgrel"
            if [ -f "$DBPATH/installed/$i/files" ]; then
                while IFS= read -r file; do
                    [ -f "$file" ] && rm -f "$file"
                done < "$DBPATH/installed/$i/files"
            fi
            pkgname="$i"
            fn_pkg_post_actions
            rm -rf "$DBPATH/installed/$i"
            printf " ${BRIGHT_GREEN}done${RESET}\n"
        else
            ui_warning "$i is not installed"
        fi
    done
    printf "\n${BOLD}::${RESET} ${BRIGHT_GREEN}Removal complete${RESET}\n"
}

# Misc
fn_pkg_clean_cache() {
    rm -f "$CACHEDIR"/* 2>/dev/null
    printf "${BOLD}::${RESET} Cache cleaned.\n"
}

fn_pkg_list_installed() {
    local dir
    for dir in "$DBPATH"/installed/*/; do
        [ -f "$dir/pkginfo" ] || continue
        # shellcheck source=/dev/null
        . "$dir/pkginfo"
        printf '%s %s-%s\n' "$pkgname" "$pkgver" "$pkgrel"
    done | sort -k1,1
}

# Help
fn_pkg_show_help() {
    printf "\n${BOLD}fetch2${RESET} - Slackware package manager\n\n"
    printf "${BOLD}Usage:${RESET} %s <command> [arguments]\n\n" "$(basename "$0")"
    printf "${BOLD}Commands:${RESET}\n"
    printf "  ${CYAN}up${RESET}              Update repository database\n"
    printf "  ${CYAN}sr${RESET} <term>       Search for packages\n"
    printf "  ${CYAN}dl${RESET} <pkg...>     Download package(s)\n"
    printf "  ${CYAN}xp${RESET} <file>       Extract a single package\n"
    printf "  ${CYAN}xa${RESET}              Extract all packages into install directory\n"
    printf "  ${CYAN}it${RESET} <pkg...>     Install package(s)\n"
    printf "  ${CYAN}rm${RESET} <pkg...>     Uninstall package(s)\n"
    printf "  ${CYAN}cc${RESET}              Delete cached packages\n"
    printf "  ${CYAN}li${RESET}              List installed packages\n"
    printf "\n"
}

# Arguments handling
case "$1" in
    up) fn_repo_update ;;
    sr) ARG="$2"; fn_pkg_search ;;
    dl) shift; [ $# -eq 0 ] && { ui_error "No packages specified"; exit 1; }
        fn_pkg_download_all "$@" ;;
    xp) ARG="$2"; fn_pkg_extract ;;
    xa) fn_pkg_extract_all ;;
    it) shift; [ $# -eq 0 ] && { ui_error "No packages specified"; exit 1; }
        fn_pkg_install "$@" ;;
    rm) shift; [ $# -eq 0 ] && { ui_error "No packages specified"; exit 1; }
        fn_pkg_remove "$@" ;;
    cc) fn_pkg_clean_cache ;;
    li) fn_pkg_list_installed ;;
    *)  fn_pkg_show_help ;;
esac

#!/bin/bash
# fetch2 - Slackware package manager
# Author: simargl <https://github.com/simargl>
# License: GPL v3

VERSION="14.2"
MAIN_MIRROR="https://mirror.de.leaseweb.net/slackware/slackware64-$VERSION"
OTHER_MIRRORS=("https://download.salixos.org/x86_64/$VERSION"
"https://download.salixos.org/x86_64/extra-$VERSION")
DBPATH="/var/lib/slackware"
CACHEDIR="/var/cache/slackware"

# Root check
if [[ $EUID -ne 0 ]]; then
    printf "Error: This script must be run as root\n"
    exit 1
fi

# Colors
if [ -t 1 ]; then
    RESET='\033[0m'; BOLD='\033[1m'; DIM='\033[2m'
    RED='\033[31m'; GREEN='\033[32m'; YELLOW='\033[33m'; CYAN='\033[36m'
    BRIGHT_GREEN='\033[92m'; BRIGHT_YELLOW='\033[93m'; BRIGHT_RED='\033[91m'
else
    RESET=''; BOLD=''; DIM=''; RED=''; GREEN=''; YELLOW=''; CYAN=''
    BRIGHT_GREEN=''; BRIGHT_YELLOW=''; BRIGHT_RED=''
fi

# UI
ui_section() { printf "\n${BOLD}::${RESET} ${BOLD}%s${RESET}\n" "$1"; }
ui_error() { printf "${BRIGHT_RED}${BOLD}error:${RESET} %s\n" "$1"; }
ui_warning() { printf "${BRIGHT_YELLOW}${BOLD}warning:${RESET} %s\n" "$1"; }

# Repository
fn_download_file() {
    printf " %s" "$3"
    wget -q -nv --no-check-certificate "$1" -P "$2"
    printf " ${BRIGHT_GREEN}done${RESET}\n"
}

fn_repo_update() {
    [ -f "$DBPATH/packages.db" ] && rm "$DBPATH/packages.db"
    ui_section "Synchronizing package databases..."
    printf " ${BOLD}Slackware $VERSION${RESET}\n"
    for i in extra patches; do
        fn_download_file "$MAIN_MIRROR/$i/PACKAGES.TXT" "$DBPATH" "$i"
        cd "$DBPATH" || exit
        extract_package_info "$MAIN_MIRROR" "PACKAGES.TXT" >> "$DBPATH/packages.db"
        rm PACKAGES.*
    done
    fn_download_file "$MAIN_MIRROR/PACKAGES.TXT" "$DBPATH" "core"
    extract_package_info "$MAIN_MIRROR" "PACKAGES.TXT" >> "$DBPATH/packages.db"
    rm PACKAGES.*
    printf "\n ${BOLD}Salix${RESET}\n"
    for ((i=0;i<"${#OTHER_MIRRORS[@]}";i++)); do
        repo_name="$(basename "${OTHER_MIRRORS[i]}")"
        printf " %s" "$repo_name"
        wget -q -nv --no-check-certificate "${OTHER_MIRRORS[i]}/PACKAGES.TXT" -P "$DBPATH"
        if [ -f "$DBPATH/PACKAGES.TXT" ]; then
            extract_package_info "${OTHER_MIRRORS[i]}" "PACKAGES.TXT" >> "$DBPATH/packages.db"
            rm PACKAGES.*
            printf " ${BRIGHT_GREEN}done${RESET}\n"
        else
            printf " ${BRIGHT_YELLOW}failed${RESET}\n"
        fi
    done
    PACKAGE_COUNT="$(grep -c ^ "$DBPATH/packages.db")"
    printf "\n${BOLD}::${RESET} Synchronization complete ${DIM}(%s packages)${RESET}\n" "$PACKAGE_COUNT"
}

extract_package_info() {
awk -v mirror="$1" '
BEGIN { FS=": "; OFS="|"; url=""; description="" }
/^PACKAGE NAME:/ {
    package_name=$2
    gsub(/^[ \t]+|[ \t]+$/,"",package_name)
}
/^PACKAGE LOCATION:/ {
    gsub(/^[ \t]+|[ \t]+$/,"",$2)
    gsub(/^\./,"",$2)
    url=mirror "/" $2 "/" package_name
}
/^PACKAGE DESCRIPTION:/ {
    getline
    description=$0
    sub(/^.*: /,"",description)
}
/^$/ {
    if(package_name!="" && url!="") print url,description
    url=""; description=""
}
END {
    if(package_name!="" && url!="") print url,description
}' "$2"
}

# Search
fn_pkg_search_print_out() {
    e_url="$1"
    e_filename="${e_url##*/}"
    e_base="${e_filename%.t?z}"
    e_release="${e_base##*-}"
    e_temp="${e_base%-*}"
    e_arch="${e_temp##*-}"
    e_temp="${e_temp%-*}"
    e_version="${e_temp##*-}"
    e_name="${e_temp%-*}"
    e_desc="$(echo "$2" | sed "s/$e_name //g")"
    status=""
    if [ -d "$DBPATH/installed/$e_name" ] && [ -f "$DBPATH/installed/$e_name/pkginfo" ]; then
        source "$DBPATH/installed/$e_name/pkginfo"
        if [ "$pkgver" = "$e_version" ] && [ "$pkgrel" = "$e_release" ]; then
            status=" ${BRIGHT_GREEN}[installed]${RESET}"
        fi
    fi
    printf " ${BOLD}%s${RESET} %s-%s %s%b\n" "$e_name" "$e_version" "$e_release" "$e_arch" "$status"
    e_desc_no_braces="$(echo "$e_desc" | sed 's/[()]//g')"
    printf "    ${DIM}%s${RESET}\n\n" "$e_desc_no_braces"
}

fn_pkg_search() {
    if [[ $ARG ]]; then
        PKGSEARCH=$(grep -i "$ARG" "$DBPATH/packages.db")
        ui_section "Searching for $ARG..."
        if [[ "$PKGSEARCH" != "" ]]; then
            count=0
            while read -r result; do
                urlR="$(echo "$result" | cut -d '|' -f1)"
                descriptionR="$(echo "$result" | cut -d '|' -f2)"
                fn_pkg_search_print_out "$urlR" "$descriptionR"
                count=$((count+1))
            done <<< "$PKGSEARCH"
            if [ "$count" -eq 1 ]; then
                printf "${BOLD}::${RESET} 1 package found\n"
            else
                printf "${BOLD}::${RESET} %s packages found\n" "$count"
            fi
        else
            ui_error "No results found for '$ARG'"
        fi
    else
        ui_warning "Please provide a search term."
    fi
}

fn_get_pkgmatch() {
    grep "/$1-[0-9]" "$DBPATH/packages.db" | head -1 | cut -d '|' -f1
}

fn_check_pkgmatch_exists() {
    unset MISSING
    LIST="$@"
    for ONE in $LIST; do
        PKGMATCH="$(fn_get_pkgmatch "$ONE")"
        if [[ $PKGMATCH == "" ]]; then
            MISSING+=("$ONE")
        fi
    done
    if [[ ${#MISSING[@]} != 0 ]]; then
        for i in "${MISSING[@]}"; do
            ui_error "Unable to locate package $i"
        done
        exit 1
    fi
}

# Download
fn_pkg_download() {
    if [ $ARG ]; then
        PKGMATCH="$(fn_get_pkgmatch "$ARG")"
        if [[ "$PKGMATCH" != "" ]]; then
            FILE="$(basename "$PKGMATCH")"
            if [ ! -f "$CACHEDIR/$FILE" ]; then
                printf " %s" "$FILE"
                wget -q -nv --no-check-certificate "$PKGMATCH" -P "$CACHEDIR"
                if [ ! -f "$CACHEDIR/$FILE" ]; then
                    printf " ${BRIGHT_RED}failed${RESET}\n"
                    ui_error "$FILE download failed"
                    exit 1
                fi
                printf " ${BRIGHT_GREEN}done${RESET}\n"
            else
                printf " %s ${DIM}[cached]${RESET}\n" "$FILE"
            fi
        else
            ui_error "Unable to locate package $ARG"
        fi
    fi
}

fn_pkg_download_all() {
    fn_check_pkgmatch_exists $ARGD
    max_parallel=7
    current_jobs=0
    for pkg in $ARGD; do
        ARG="$pkg"
        fn_pkg_download &
        current_jobs=$((current_jobs+1))
        if [ "$current_jobs" -ge "$max_parallel" ]; then
            wait -n
            current_jobs=$((current_jobs-1))
        fi
    done
    wait
}

# Metadata
fn_write_metadata() {
    nv="$(echo "$1" | sed 's/\(.*\)-[^-]*-[^-]*$/\1/')"
    pkgname="$(echo "$nv" | sed 's/-[^-]*$//')"
    pkgver="$(echo "$nv" | sed 's/.*-//')"
    pkgrel="$(echo "${1##*-}" | sed 's/.t.z//')"
    mkdir -p "$2/$DBPATH/installed/$pkgname"
    echo pkgname="$pkgname" > "$2/$DBPATH/installed/$pkgname/pkginfo"
    echo pkgver="$pkgver" >> "$2/$DBPATH/installed/$pkgname/pkginfo"
    echo pkgrel="$pkgrel" >> "$2/$DBPATH/installed/$pkgname/pkginfo"
    tar -tvf "$1" | awk '!/^d/ {print $NF}' | grep -v "install/" | sed 's/^/\//' > "$2/$DBPATH/installed/$pkgname/files"
}

# Extract
fn_pkg_extract() {
    if [[ "$ARG" != "" && -f "$ARG" ]]; then
        ui_section "Extracting package..."
        printf " %s" "$(basename "$ARG")"
        tar -xf "$ARG"
        printf " ${BRIGHT_GREEN}done${RESET}\n"
    else
        ui_error "Extraction failed: File not found or invalid."
        exit 1
    fi
}

fn_pkg_extract_all() {
    ui_section "Extracting packages..."
    for i in *.t?z; do
        [[ -e "$i" ]] || break
        ARG="$i"
        printf " %s" "$ARG"
        [ ! -d install ] && mkdir install
        tar -xf "$ARG" -C install
        if [ -f "install/install/doinst.sh" ]; then
            cd install && sh ./install/doinst.sh 2>/dev/null
            cd "$OLDPWD" || exit
        fi
        fn_write_metadata "$ARG" install
        [ -d install/install ] && rm -r install/install
        printf " ${BRIGHT_GREEN}done${RESET}\n"
    done
}

# Post-install
fn_pkg_post_actions() {
    local ICONS DESKTOP GSETTINGS FONTS
    ICONS=$(grep /usr/share/icons/hicolor "$DBPATH/installed/$pkgname/files" || true)
    DESKTOP=$(grep /usr/share/applications "$DBPATH/installed/$pkgname/files" || true)
    GSETTINGS=$(grep /usr/share/glib-2.0/schemas "$DBPATH/installed/$pkgname/files" || true)
    FONTS=$(grep /usr/share/fonts/TTF "$DBPATH/installed/$pkgname/files" || true)
    local file_paths=("$ICONS" "$DESKTOP" "$GSETTINGS" "$FONTS")
    for file_path in "${file_paths[@]}"; do
        if [ "$file_path" ]; then
            case "$file_path" in
                "$ICONS")
                    printf "  updating icon cache..."
                    gtk-update-icon-cache /usr/share/icons/hicolor >/dev/null 2>&1
                    printf " ${BRIGHT_GREEN}done${RESET}\n"
                    ;;
                "$DESKTOP")
                    printf "  updating desktop database..."
                    update-desktop-database >/dev/null 2>&1
                    printf " ${BRIGHT_GREEN}done${RESET}\n"
                    ;;
                "$GSETTINGS")
                    printf "  compiling GSettings schemas..."
                    glib-compile-schemas /usr/share/glib-2.0/schemas >/dev/null 2>&1
                    printf " ${BRIGHT_GREEN}done${RESET}\n"
                    ;;
                "$FONTS")
                    printf "  updating font cache..."
                    fc-cache -f -s >/dev/null 2>&1
                    mkfontscale /usr/share/fonts/TTF >/dev/null 2>&1
                    mkfontdir /usr/share/fonts/TTF >/dev/null 2>&1
                    printf " ${BRIGHT_GREEN}done${RESET}\n"
                    ;;
            esac
        fi
    done
}

fn_run_install_script() {
    if [ -f "$1" ]; then
        cd / && sh "$1" 2>/dev/null
        cd "$OLDPWD"
    fi
}

fn_cleanup_install_directory() {
    [ -d /install ] && rm -r /install
}

# Install
fn_pkg_install_local() {
    if [[ "$ARG" != "" && -f "$ARG" ]]; then
        PACKAGE_FILE="$(basename "$ARG")"
        PACKAGE_BASE="${PACKAGE_FILE%.t?z}"
        PACKAGE_RELEASE="${PACKAGE_BASE##*-}"
        PACKAGE_TEMP="${PACKAGE_BASE%-*}"
        PACKAGE_ARCH="${PACKAGE_TEMP##*-}"
        PACKAGE_TEMP="${PACKAGE_TEMP%-*}"
        PACKAGE_VERSION="${PACKAGE_TEMP##*-}"
        PACKAGE_NAME="${PACKAGE_TEMP%-*}"
        printf " %s %s-%s %s\n" "$PACKAGE_NAME" "$PACKAGE_VERSION" "$PACKAGE_RELEASE" "$PACKAGE_ARCH"
        tar -xf "$ARG" -C /
        fn_run_install_script "/install/doinst.sh"
        fn_write_metadata "$ARG" /
        fn_cleanup_install_directory
        fn_pkg_post_actions
    else
        ui_error "Installation failed: File not found or invalid."
        exit 1
    fi
}

fn_pkg_install() {
    LOCAL="false"
    for ONE in $ARGI; do
        if [ -f "$ONE" ]; then
            LOCAL="true"
            ARG="$ONE"
            NAME="$(echo "$ARG" | sed 's/\(.*\)-[^-]*-[^-]*$/\1/' | sed 's/-[^-]*$//')"
            if [ -d "$DBPATH/installed/$NAME" ]; then
                ui_warning "$ARG is already installed"
            else
                ui_section "Installing package..."
                fn_pkg_install_local
            fi
        fi
    done
    if [ "$LOCAL" = true ]; then exit 0; fi
    fn_check_pkgmatch_exists "$ARGI"
    for ONE in $ARGI; do
        ARG="$ONE"
        if [ -d "$DBPATH/installed/$ARG" ]; then
            ui_warning "$ARG is already installed"
            exit 1
        fi
    done
    ARGD="$ARGI"
    ui_section "Downloading packages..."
    fn_pkg_download_all
    printf "\n${BOLD}::${RESET} Installing packages...\n"
    for ONE in $ARGI; do
        ARG="$ONE"
        PKGMATCH="$(fn_get_pkgmatch "$ARG")"
        FILE="$(basename "$PKGMATCH")"
        if [ -f "$CACHEDIR/$FILE" ]; then
            ARG="$FILE"
            cd "$CACHEDIR" && fn_pkg_install_local && cd "$OLDPWD"
        fi
    done
    printf "\n${BOLD}::${RESET} ${BRIGHT_GREEN}Installation complete${RESET}\n"
}

# Remove
fn_pkg_remove() {
    ui_section "Removing packages..."
    for i in $ARGR; do
        if [ -f "$DBPATH/installed/$i/pkginfo" ]; then
            source "$DBPATH/installed/$i/pkginfo"
            printf " %s %s-%s\n" "$i" "$pkgver" "$pkgrel"
            cat "$DBPATH/installed/$i/files" | while read -r file; do
                [ -f "$file" ] && rm "$file"
            done
            fn_pkg_post_actions
            rm -r "$DBPATH/installed/$i"
            printf " ${BRIGHT_GREEN}done${RESET}\n"
        else
            ui_warning "$i is not installed"
        fi
    done
    printf "\n${BOLD}::${RESET} ${BRIGHT_GREEN}Removal complete${RESET}\n"
}

# Misc
fn_pkg_clean_cache() {
    rm "$CACHEDIR"/* 2>/dev/null
}

fn_pkg_list_installed() {
    local dir
    for dir in "$DBPATH"/installed/*/; do
        [ -f "$dir/pkginfo" ] || continue
        . "$dir/pkginfo"
        printf '%s %s-%s\n' "$pkgname" "$pkgver" "$pkgrel"
    done | sort -k1,1
}

# Help
fn_pkg_show_help() {
    printf "\n${BOLD}fetch2${RESET} - Slackware package manager\n\n"
    printf "${BOLD}Usage:${RESET} %s <command> [arguments]\n\n" "$(basename "$0")"
    printf "${BOLD}Commands:${RESET}\n"
    printf "  ${CYAN}up${RESET}              Update repository database\n"
    printf "  ${CYAN}sr${RESET} <term>       Search for packages\n"
    printf "  ${CYAN}dl${RESET} <pkg...>     Download package(s)\n"
    printf "  ${CYAN}xp${RESET} <file>       Extract a single package\n"
    printf "  ${CYAN}xa${RESET}              Extract all packages\n"
    printf "  ${CYAN}it${RESET} <pkg...>     Install package(s)\n"
    printf "  ${CYAN}rm${RESET} <pkg...>     Uninstall package(s)\n"
    printf "  ${CYAN}cc${RESET}              Delete cached packages\n"
    printf "  ${CYAN}li${RESET}              List installed packages\n"
    printf "\n"
}

# Arguments
case "$1" in
    up) fn_repo_update ;;
    sr) ARG="$2"; fn_pkg_search ;;
    dl) shift; ARGD="$@"; fn_pkg_download_all ;;
    xp) ARG="$2"; fn_pkg_extract ;;
    xa) fn_pkg_extract_all ;;
    it) shift; ARGI="$@"; fn_pkg_install ;;
    rm) shift; ARGR="$@"; fn_pkg_remove ;;
    cc) fn_pkg_clean_cache ;;
    li) fn_pkg_list_installed ;;
    *) fn_pkg_show_help ;;
esac

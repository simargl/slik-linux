# License: GPL v3

VERSION="14.1"
MAIN_MIRROR="https://mirror.de.leaseweb.net/slackware/slackware64-$VERSION"
OTHER_MIRRORS=(
    "https://slackware.uk/salix/x86_64/$VERSION"
    "https://slackware.uk/salix/x86_64/extra-$VERSION"
)
DBPATH="/var/lib/fetch"
CACHEDIR="/var/cache/fetch"
LOGDIR="/var/log/packages"
SCRIPTDIR="/var/log/scripts"

mkdir -p "$DBPATH" "$CACHEDIR" "$LOGDIR" "$SCRIPTDIR"

if [[ $EUID -ne 0 ]]; then
    printf "Error: This script must be run as root\n" >&2
    exit 1
fi

# Colors
if [ -t 1 ]; then
    RESET='\033[0m'; BOLD='\033[1m'; DIM='\033[2m'
    RED='\033[31m'; GREEN='\033[32m'; YELLOW='\033[33m'; CYAN='\033[36m'
    BRIGHT_GREEN='\033[92m'; BRIGHT_YELLOW='\033[93m'; BRIGHT_RED='\033[91m'
else
    RESET=''; BOLD=''; DIM=''; RED=''; GREEN=''; YELLOW=''; CYAN=''
    BRIGHT_GREEN=''; BRIGHT_YELLOW=''; BRIGHT_RED=''
fi

# UI
ui_section() { printf "\n${BOLD}::${RESET} ${BOLD}%s${RESET}\n" "$1"; }
ui_error() { printf "${BRIGHT_RED}${BOLD}error:${RESET} %s\n" "$1" >&2; }
ui_warning() { printf "${BRIGHT_YELLOW}${BOLD}warning:${RESET} %s\n" "$1"; }

# Repository
fn_download_file() {
    printf " %s" "$3"
    wget -q -nv --no-check-certificate "$1" -P "$2"
    printf " ${BRIGHT_GREEN}done${RESET}\n"
}

extract_package_info() {
awk -v mirror="$1" '
BEGIN { FS=": "; OFS="|" }

/^PACKAGE NAME:/ {
    pkgfile=$2
    sub(/^[ \t]+|[ \t]+$/, "", pkgfile)
}

/^PACKAGE LOCATION:/ {
    location=$2
    sub(/^[ \t]+|[ \t]+$/, "", location)
    sub(/^\.\/+/, "", location)
}

/^PACKAGE DESCRIPTION:/ {
    getline
    description=$0
    sub(/^.*: /, "", description)
}

/^$/ {
    if (pkgfile && location) {
        f=pkgfile
        sub(/\.t[glx]z$/, "", f)

        release=f
        sub(/^.*-/, "", release)

        tmp=f
        sub(/-[^-]*$/, "", tmp)

        arch=tmp
        sub(/^.*-/, "", arch)

        tmp2=tmp
        sub(/-[^-]*$/, "", tmp2)

        version=tmp2
        sub(/^.*-/, "", version)

        name=tmp2
        sub(/-[^-]*$/, "", name)

        print name,version,arch,release,mirror "/" location "/" pkgfile,description
    }

    pkgfile=location=description=""
}

END {
    if (pkgfile && location) {
        f=pkgfile
        sub(/\.t[glx]z$/, "", f)

        release=f
        sub(/^.*-/, "", release)

        tmp=f
        sub(/-[^-]*$/, "", tmp)

        arch=tmp
        sub(/^.*-/, "", arch)

        tmp2=tmp
        sub(/-[^-]*$/, "", tmp2)

        version=tmp2
        sub(/^.*-/, "", version)

        name=tmp2
        sub(/-[^-]*$/, "", name)

        print name,version,arch,release,mirror "/" location "/" pkgfile,description
    }
}' "$2"
}

fn_repo_update() {
    rm -f "$DBPATH/packages.db"
    ui_section "Synchronizing package databases..."
    printf " ${BOLD}Slackware $VERSION${RESET}\n"

    for i in extra patches; do
        TMP_DIR=$(mktemp -d)
        fn_download_file "$MAIN_MIRROR/$i/PACKAGES.TXT" "$TMP_DIR" "$i"
        [ -f "$TMP_DIR/PACKAGES.TXT" ] &&
            extract_package_info "$MAIN_MIRROR" "$TMP_DIR/PACKAGES.TXT" >> "$DBPATH/packages.db"
        rm -rf "$TMP_DIR"
    done

    TMP_DIR=$(mktemp -d)
    fn_download_file "$MAIN_MIRROR/PACKAGES.TXT" "$TMP_DIR" "core"
    [ -f "$TMP_DIR/PACKAGES.TXT" ] &&
        extract_package_info "$MAIN_MIRROR" "$TMP_DIR/PACKAGES.TXT" >> "$DBPATH/packages.db"
    rm -rf "$TMP_DIR"

    printf "\n ${BOLD}Salix${RESET}\n"
    for repo_url in "${OTHER_MIRRORS[@]}"; do
        repo_name="${repo_url##*/}"
        printf " %s" "$repo_name"
        TMP_DIR=$(mktemp -d)
        wget -q -nv --no-check-certificate "$repo_url/PACKAGES.TXT" -P "$TMP_DIR"
        if [ -f "$TMP_DIR/PACKAGES.TXT" ]; then
            extract_package_info "$repo_url" "$TMP_DIR/PACKAGES.TXT" >> "$DBPATH/packages.db"
            printf " ${BRIGHT_GREEN}done${RESET}\n"
        else
            printf " ${BRIGHT_YELLOW}failed${RESET}\n"
        fi
        rm -rf "$TMP_DIR"
    done

    PACKAGE_COUNT=$(grep -c '^' "$DBPATH/packages.db" 2>/dev/null || echo 0)
    printf "\n${BOLD}::${RESET} Synchronization complete ${DIM}(%s packages)${RESET}\n" "$PACKAGE_COUNT"
}

# Search
fn_pkg_search_print_out() {
    local name="$1" version="$2" arch="$3" release="$4" url="$5" desc="$6" status=""
    if ls "$LOGDIR/$name-"* >/dev/null 2>&1; then
        for installed_pkg in "$LOGDIR/$name-"*; do
            [ -f "$installed_pkg" ] || continue
            local base_pkg="${installed_pkg##*/}"
            if [ "$base_pkg" = "$name-$version-$arch-$release" ]; then
                status=" ${BRIGHT_GREEN}[installed]${RESET}"
                break
            fi
        done
    fi
    printf " ${BOLD}%s${RESET} %s-%s %s%b\n" "$name" "$version" "$release" "$arch" "$status"
    printf "    ${DIM}%s${RESET}\n\n" "${desc//[()]/}"
}

fn_pkg_search() {
    local search_term="$1"
    [ -z "$search_term" ] && { ui_warning "Please provide a search term."; return 1; }
    [ ! -f "$DBPATH/packages.db" ] && {
        ui_error "Package database missing. Please run 'fetch up' first."
        return 1
    }

    ui_section "Searching for $search_term..."

    local count=0
    local tmp_results
    tmp_results=$(mktemp)

    awk -F'|' -v term="$search_term" '
        BEGIN { IGNORECASE=1 }
        index($1,term) || index($6,term)
    ' "$DBPATH/packages.db" > "$tmp_results"

    while IFS='|' read -r name version arch release url desc; do
        [ -z "$name" ] && continue
        fn_pkg_search_print_out "$name" "$version" "$arch" "$release" "$url" "$desc"
        count=$((count+1))
    done < "$tmp_results"

    rm -f "$tmp_results"

    if [ "$count" -eq 0 ]; then
        ui_error "No results found for '$search_term'"
        return 1
    else
        printf "${BOLD}::${RESET} %s package%s found\n" \
            "$count" "$([ "$count" -eq 1 ] && echo "" || echo "s")"
    fi
}

fn_get_pkgmatch() {
    [ -f "$DBPATH/packages.db" ] &&
        awk -F'|' -v n="$1" '$1 == n {print $5; exit}' "$DBPATH/packages.db"
}

fn_check_pkgmatch_exists() {
    local missing=() ONE
    for ONE in "$@"; do
        [ -z "$(fn_get_pkgmatch "$ONE")" ] && missing+=("$ONE")
    done
    if [ "${#missing[@]}" -gt 0 ]; then
        for ONE in "${missing[@]}"; do ui_error "Unable to locate package $ONE"; done
        exit 1
    fi
}

# Download
fn_pkg_download() {
    local pkg_name="$1" pkgmatch file
    pkgmatch="$(fn_get_pkgmatch "$pkg_name")"
    [ -z "$pkgmatch" ] && { ui_error "Unable to locate package $pkg_name"; return 1; }

    file="${pkgmatch##*/}"
    if [ ! -f "$CACHEDIR/$file" ]; then
        printf " %s" "$file"
        wget -q -nv --no-check-certificate "$pkgmatch" -P "$CACHEDIR"
        if [ ! -f "$CACHEDIR/$file" ]; then
            printf " ${BRIGHT_RED}failed${RESET}\n"
            ui_error "$file download failed"
            return 1
        fi
        printf " ${BRIGHT_GREEN}done${RESET}\n"
    else
        printf " %s ${DIM}[cached]${RESET}\n" "$file"
    fi
}

fn_pkg_download_all() {
    fn_check_pkgmatch_exists "$@"
    local max_parallel=7 pids=() pkg
    for pkg in "$@"; do
        fn_pkg_download "$pkg" &
        pids+=($!)
        if [ "${#pids[@]}" -ge "$max_parallel" ]; then
            wait "${pids[0]}"
            pids=("${pids[@]:1}") # Shift the array to remove the finished PID
        fi
    done
    wait
}

# Extract Single
fn_pkg_extract() {
    local file_path="$1"
    if [[ -n "$file_path" && -f "$file_path" ]]; then
        ui_section "Extracting package..."
        printf " %s" "$(basename "$file_path")"
        tar -xf "$file_path"
        printf " ${BRIGHT_GREEN}done${RESET}\n"
    else
        ui_error "Extraction failed: File not found or invalid."
        exit 1
    fi
}

# Native Metadata & Logging Generation
fn_write_native_metadata() {
    local target_file="$1"
    local destdir="${2:-}"
    local base="${target_file##*/}"
    base="${base%.t?z}"
    
    local log_dir="${destdir:-}/var/log/packages"
    local script_dir="${destdir:-}/var/log/scripts"
    mkdir -p "$log_dir" "$script_dir"
    
    local log_file="$log_dir/$base"
    local script_file="$script_dir/$base"
    
    local unressed_size
    unressed_size=$(tar -tvf "$target_file" 2>/dev/null | awk '{s+=$3} END {print s}')

    {
        printf "PACKAGE NAME:      %s\n" "$base"
        printf "COMPRESSED PACKAGE SIZE:     %s\n" "$(du -h "$target_file" | awk '{print $1}')"
        printf "UNCOMPRESSED PACKAGE SIZE:     %s\n" "$unressed_size"
        printf "PACKAGE LOCATION: %s\n" "$target_file"
        printf "PACKAGE DESCRIPTION:\n"
        
        if tar -tOf "$target_file" install/slack-desc >/dev/null 2>&1; then
            tar -xOf "$target_file" install/slack-desc 2>/dev/null
        else
            printf "%s:     %s: Native package installed via fetch\n" "${base%%-*}" "$base"
        fi
        
        printf "FILE LIST:\n"
        tar -tf "$target_file" | LC_COLLATE=C sort
    } > "$log_file"

    if tar -tf "$target_file" | grep -q '^install/doinst.sh'; then
        tar -O -xf "$target_file" install/doinst.sh > "$script_file"
        chmod +x "$script_file"
    else
        touch "$script_file"
    fi
}

fn_pkg_extract_all() {
    local destdir="root.x86_64"
    ui_section "Extracting packages..."
    mkdir -p "$destdir/var/log/packages" "$destdir/var/log/scripts"
    
    local pkg_found=0
    for i in "$CACHEDIR"/*.t?z ./*.t?z; do
        [[ -e "$i" ]] || continue
        pkg_found=1
        local current_file="$i"
        local base="${current_file##*/}"
        base="${base%.t?z}"
        
        printf " %s" "$base"
        tar -xf "$current_file" -C "$destdir"
        
        if [ -f "$destdir/install/doinst.sh" ]; then
            (cd "$destdir" && sh ./install/doinst.sh 2>/dev/null)
            cp "$destdir/install/doinst.sh" "$destdir/var/log/scripts/$base"
            chmod +x "$destdir/var/log/scripts/$base"
        else
            touch "$destdir/var/log/scripts/$base"
        fi
        
        fn_write_native_metadata "$current_file" "$destdir"
        [ -d "$destdir/install" ] && rm -rf "$destdir/install"
        
        printf " ${BRIGHT_GREEN}done${RESET}\n"
    done

    if [ "$pkg_found" -eq 0 ]; then
        ui_error "No package archives found in cache or current directory."
        return 1
    fi
}

# Install
fn_pkg_install_local() {
    local target_file="$1"
    [ -f "$target_file" ] || {
        ui_error "Installation failed: File not found or invalid."
        return 1
    }

    local PACKAGE_FILE PACKAGE_BASE
    local PACKAGE_RELEASE PACKAGE_TEMP PACKAGE_ARCH
    local PACKAGE_VERSION PACKAGE_NAME

    PACKAGE_FILE="${target_file##*/}"
    PACKAGE_BASE="$PACKAGE_FILE"
    PACKAGE_BASE="${PACKAGE_BASE%.txz}"
    PACKAGE_BASE="${PACKAGE_BASE%.tgz}"
    PACKAGE_BASE="${PACKAGE_BASE%.tlz}"
    PACKAGE_BASE="${PACKAGE_BASE%.tbz}"

    PACKAGE_RELEASE="${PACKAGE_BASE##*-}"
    PACKAGE_TEMP="${PACKAGE_BASE%-*}"
    PACKAGE_ARCH="${PACKAGE_TEMP##*-}"
    PACKAGE_TEMP="${PACKAGE_TEMP%-*}"
    PACKAGE_VERSION="${PACKAGE_TEMP##*-}"
    PACKAGE_NAME="${PACKAGE_TEMP%-*}"

    printf " %s %s-%s %s\n" \
        "$PACKAGE_NAME" "$PACKAGE_VERSION" "$PACKAGE_RELEASE" "$PACKAGE_ARCH"

    tar -xf "$target_file" -C / || {
        ui_error "Failed to extract $PACKAGE_FILE"
        return 1
    }

    if [ -f /install/doinst.sh ]; then
        (cd / && sh /install/doinst.sh >/dev/null 2>&1)
    fi
    [ -d /install ] && rm -rf /install

    fn_write_native_metadata "$target_file"
    fn_pkg_post_actions "$PACKAGE_NAME"
}

fn_pkg_install() {
    local ONE name
    local local_install=false
    local to_install=()

    # Check local files first
    for ONE in "$@"; do
        if [ -f "$ONE" ]; then
            local_install=true
            name="$(basename "$ONE" | sed 's/\(.*\)-[^-]*-[^-]*$/\1/' | sed 's/-[^-]*$//')"
            if ls "$LOGDIR/$name-"* >/dev/null 2>&1; then
                ui_warning "$ONE is already installed"
            else
                to_install+=("$ONE")
            fi
        fi
    done

    if [ "$local_install" = true ]; then
        if [ ${#to_install[@]} -eq 0 ]; then
            printf "\n${BOLD}::${RESET} Nothing to do.\n"
            return 0
        fi
        ui_section "Installing package(s)..."
        for ONE in "${to_install[@]}"; do
            fn_pkg_install_local "$ONE"
        done
        return 0
    fi

    # Remote packages verification
    fn_check_pkgmatch_exists "$@"

    # Filter out already installed packages, warning for each, and queue the rest
    for ONE in "$@"; do
        if ls "$LOGDIR/$ONE-"* >/dev/null 2>&1; then
            ui_warning "$ONE is already installed"
        else
            to_install+=("$ONE")
        fi
    done

    if [ ${#to_install[@]} -eq 0 ]; then
        printf "\n${BOLD}::${RESET} All requested packages are already installed. Nothing to do.\n"
        return 0
    fi

    ui_section "Downloading packages..."
    fn_pkg_download_all "${to_install[@]}"

    printf "\n${BOLD}::${RESET} Installing packages...\n"
    for ONE in "${to_install[@]}"; do
        local pkgmatch file
        pkgmatch="$(fn_get_pkgmatch "$ONE")"
        file="${pkgmatch##*/}"
        [ -f "$CACHEDIR/$file" ] && fn_pkg_install_local "$CACHEDIR/$file"
    done
    printf "\n${BOLD}::${RESET} ${BRIGHT_GREEN}Installation complete${RESET}\n"
}

# Remove
fn_pkg_remove() {
    ui_section "Removing packages..."
    local i pkg_log file removed_count=0
    for i in "$@"; do
        pkg_log=""
        if [ -f "$LOGDIR/$i" ]; then
            pkg_log="$LOGDIR/$i"
        else
            pkg_log="$(ls "$LOGDIR/$i-"* 2>/dev/null | head -n 1)"
        fi

        if [ -n "$pkg_log" ] && [ -f "$pkg_log" ]; then
            local real_pkg_name="${pkg_log##*/}"
            printf " removing %s\n" "$real_pkg_name"
            
            removepkg "$real_pkg_name" >/dev/null 2>&1

            fn_pkg_post_actions "${real_pkg_name%%-*}"
            rm -f "$pkg_log"
            rm -f "$SCRIPTDIR/$real_pkg_name"
            printf " ${BRIGHT_GREEN}done${RESET}\n"
            removed_count=$((removed_count + 1))
        else
            ui_error "$i is not installed"
        fi
    done
    
    if [ "$removed_count" -gt 0 ]; then
        printf "\n${BOLD}::${RESET} ${BRIGHT_GREEN}Removal complete${RESET}\n"
    else
        return 1
    fi
}

# Post-install cache updates
fn_pkg_post_actions() {
    local target_pkgname="$1"
    local pkg_log
    pkg_log="$(ls "$LOGDIR/$target_pkgname-"[0-9]* 2>/dev/null | head -n 1)"
    [ -f "$pkg_log" ] || return

    grep -q '/usr/share/icons/hicolor' "$pkg_log" &&
        { printf "  updating icon cache..."; gtk-update-icon-cache /usr/share/icons/hicolor >/dev/null 2>&1; printf " ${BRIGHT_GREEN}done${RESET}\n"; }
    grep -q '/usr/share/applications' "$pkg_log" &&
        { printf "  updating desktop database..."; update-desktop-database >/dev/null 2>&1; printf " ${BRIGHT_GREEN}done${RESET}\n"; }
    grep -q '/usr/share/glib-2.0/schemas' "$pkg_log" &&
        { printf "  compiling GSettings schemas..."; glib-compile-schemas /usr/share/glib-2.0/schemas >/dev/null 2>&1; printf " ${BRIGHT_GREEN}done${RESET}\n"; }
    grep -q '/usr/share/fonts/TTF' "$pkg_log" &&
        { printf "  updating font cache..."; fc-cache -f -s >/dev/null 2>&1; mkfontscale /usr/share/fonts/TTF >/dev/null 2>&1; mkfontdir /usr/share/fonts/TTF >/dev/null 2>&1; printf " ${BRIGHT_GREEN}done${RESET}\n"; }
}

# Misc
fn_pkg_clean_cache() {
    rm -f "$CACHEDIR"/* 2>/dev/null
    printf "${BOLD}::${RESET} Cache cleaned.\n"
}

fn_pkg_list_installed() {
    local file
    for file in "$LOGDIR"/*; do
        [ -f "$file" ] || continue
        printf '%s\n' "${file##*/}"
    done | sort
}

# Help
fn_pkg_show_help() {
    printf "\n${BOLD}fetch${RESET} - Slackware package manager\n\n"
    printf "${BOLD}Usage:${RESET} %s <command> [arguments]\n\n" "$(basename "$0")"
    printf "${BOLD}Commands:${RESET}\n"
    printf "  ${CYAN}up${RESET}            Update repository database\n"
    printf "  ${CYAN}sr${RESET} <term>     Search for packages\n"
    printf "  ${CYAN}dl${RESET} <pkg...>   Download package(s)\n"
    printf "  ${CYAN}xp${RESET} <file>     Extract a single package\n"
    printf "  ${CYAN}xa${RESET}            Extract all packages into root.x86_64 directory\n"
    printf "  ${CYAN}it${RESET} <pkg...>   Install package(s)\n"
    printf "  ${CYAN}rm${RESET} <pkg...>   Uninstall package(s)\n"
    printf "  ${CYAN}cc${RESET}            Delete cached packages\n"
    printf "  ${CYAN}li${RESET}            List installed packages\n"
    printf "\n"
}

case "$1" in
    up) fn_repo_update ;;
    sr) fn_pkg_search "$2" ;;
    dl) shift; [ $# -eq 0 ] && { ui_error "No packages specified"; exit 1; }; fn_pkg_download_all "$@" ;;
    xp) fn_pkg_extract "$2" ;;
    xa) fn_pkg_extract_all ;;
    it) shift; [ $# -eq 0 ] && { ui_error "No packages specified"; exit 1; }; fn_pkg_install "$@" ;;
    rm) shift; [ $# -eq 0 ] && { ui_error "No packages specified"; exit 1; }; fn_pkg_remove "$@" ;;
    cc) fn_pkg_clean_cache ;;
    li) fn_pkg_list_installed ;;
    *) fn_pkg_show_help; exit 1 ;;
esac

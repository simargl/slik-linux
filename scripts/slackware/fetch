VERSION="14.2"
MAIN_MIRROR="https://mirror.de.leaseweb.net/slackware/slackware64-$VERSION"
OTHER_MIRRORS=( "https://repo.greeklug.gr/data/pub/linux/salix/x86_64/$VERSION"
                "https://repo.greeklug.gr/data/pub/linux/salix/x86_64/extra-$VERSION")

DBPATH="/var/lib/slackware"
CACHEDIR="/var/cache/slackware"

# ============================================================================
# Terminal colors
# ============================================================================

if [ -t 1 ]; then
    RESET='\033[0m'
    BOLD='\033[1m'
    DIM='\033[2m'

    RED='\033[31m'
    GREEN='\033[32m'
    YELLOW='\033[33m'
    CYAN='\033[36m'

    BRIGHT_RED='\033[91m'
    BRIGHT_GREEN='\033[92m'
    BRIGHT_YELLOW='\033[93m'
    BRIGHT_CYAN='\033[96m'
    BRIGHT_WHITE='\033[97m'
else
    RESET=''
    BOLD=''
    DIM=''

    RED=''
    GREEN=''
    YELLOW=''
    CYAN=''

    BRIGHT_RED=''
    BRIGHT_GREEN=''
    BRIGHT_YELLOW=''
    BRIGHT_CYAN=''
    BRIGHT_WHITE=''
fi

# ============================================================================
# Cargo-style UI
# ============================================================================

ui_heading() {
    printf "\n"
    printf "    ${BOLD}${BRIGHT_WHITE}%s${RESET}\n" "$1"
    printf "\n"
}

ui_group() {
    printf "      ${BOLD}${BRIGHT_WHITE}%s${RESET}\n" "$1"
}

ui_action() {
    printf "        ${CYAN}%s${RESET}\n" "$1"
}

ui_finished() {
    printf "        ${BRIGHT_GREEN}Finished${RESET}\n"
}

ui_ok() {
    printf "    ${BRIGHT_GREEN}${BOLD}Finished${RESET}"
    [ -n "$1" ] && printf " ${DIM}· %s${RESET}" "$1"
    printf "\n"
}

ui_warning() {
    printf "    ${BRIGHT_YELLOW}${BOLD}warning:${RESET} %s\n" "$1"
}

ui_error() {
    printf "    ${BRIGHT_RED}${BOLD}error:${RESET} %s\n" "$1"
}

ui_detail() {
    printf "        ${DIM}%s${RESET}\n" "$1"
}

ui_repo_start() {
    ui_heading "Updating repositories"
}

ui_repo_group() {
    ui_group "$1"
}

ui_repo_download() {
    ui_action "Downloading $1"
}

ui_repo_finished() {
    ui_finished
}

ui_repo_complete() {
    local count="$1"

    count="$(printf '%s' "$count" |
        sed ':a;s/\B[0-9]\{3\}\>/,&/;ta')"

    printf "\n"
    printf "    ${BRIGHT_GREEN}${BOLD}Finished${RESET}"
    printf " ${DIM}· %s packages indexed${RESET}\n" "$count"
}

ui_search_start() {
    ui_heading "Searching for $1"
}

ui_search_package() {
    local name="$1"
    local version="$2"
    local arch="$3"
    local status="$4"

    printf "      ${BOLD}${BRIGHT_WHITE}%-20s${RESET}" "$name"
    printf " ${DIM}%-16s${RESET}" "$version"
    printf " ${DIM}%-8s${RESET}" "$arch"

    if [ -n "$status" ]; then
        printf " ${BRIGHT_GREEN}%s${RESET}" "$status"
    fi

    printf "\n"
}

ui_search_complete() {
    local count="$1"

    printf "\n"

    if [ "$count" -eq 1 ]; then
        printf "    ${BRIGHT_GREEN}${BOLD}Finished${RESET}"
        printf " ${DIM}· 1 package found${RESET}\n"
    else
        printf "    ${BRIGHT_GREEN}${BOLD}Finished${RESET}"
        printf " ${DIM}· %s packages found${RESET}\n" "$count"
    fi
}

ui_download_start() {
    ui_heading "Downloading packages"
}

ui_download_package() {
    ui_action "Downloading $1"
}

ui_download_complete() {
    printf "\n"
    ui_ok "all packages downloaded"
}

ui_install_start() {
    ui_heading "Installing packages"
}

ui_install_package() {
    printf "      ${BOLD}${BRIGHT_WHITE}%s${RESET}\n" "$1"
}

ui_install_detail() {
    printf "        ${DIM}%s${RESET}\n" "$1"
}

ui_install_action() {
    printf "        ${CYAN}%s${RESET}\n" "$1"
}

ui_install_action_done() {
    printf "          ${BRIGHT_GREEN}Finished${RESET}\n"
}

ui_install_complete() {
    printf "\n"
    ui_ok "installation complete"
}

ui_remove_start() {
    ui_heading "Removing packages"
}

ui_remove_package() {
    printf "      ${BOLD}${BRIGHT_WHITE}%s${RESET}\n" "$1"
}

ui_remove_detail() {
    printf "        ${DIM}%s${RESET}\n" "$1"
}

ui_remove_action() {
    printf "        ${CYAN}%s${RESET}\n" "$1"
}

ui_remove_complete() {
    printf "\n"
    ui_ok "removal complete"
}

# ============================================================================
# Root check
# ============================================================================

if [[ $EUID -ne 0 ]]; then
    ui_error "This script must be run as root"
    exit 1
fi

# ============================================================================
# Download file with wget
# $1 = filename
# $2 = target directory
# $3 = comment
# ============================================================================

fn_download_file() {
    ui_action "Downloading $3"
    wget -q -nv --no-check-certificate "$1" -P "$2"
}

# ============================================================================
# Repository update
# ============================================================================

fn_repo_update() {
    [ -f "$DBPATH/packages.db" ] && rm "$DBPATH/packages.db"

    ui_repo_start

    ui_repo_group "Slackware $VERSION"

    for i in extra patches; do

        fn_download_file \
            "$MAIN_MIRROR/$i/PACKAGES.TXT" \
            "$DBPATH" \
            "$i"

        cd "$DBPATH" || exit

        extract_package_info \
            "$MAIN_MIRROR" \
            "PACKAGES.TXT" >> "$DBPATH/packages.db"

        rm PACKAGES.*

        ui_repo_finished
    done

    fn_download_file \
        "$MAIN_MIRROR/PACKAGES.TXT" \
        "$DBPATH" \
        "core"

    extract_package_info \
        "$MAIN_MIRROR" \
        "PACKAGES.TXT" >> "$DBPATH/packages.db"

    rm PACKAGES.*

    ui_repo_finished

    printf "\n"

    ui_repo_group "Salix repositories"

    for ((i=0; i<"${#OTHER_MIRRORS[@]}"; ++i)); do

        repo_name="$(basename "${OTHER_MIRRORS[i]}")"

        fn_download_file \
            "${OTHER_MIRRORS[i]}/PACKAGES.TXT" \
            "$DBPATH" \
            "$repo_name"

        if [ -f "$DBPATH/PACKAGES.TXT" ]; then

            extract_package_info \
                "${OTHER_MIRRORS[i]}" \
                "PACKAGES.TXT" >> "$DBPATH/packages.db"

            rm PACKAGES.*

            ui_repo_finished
        fi
    done

    PACKAGE_COUNT="$(grep -c ^ "$DBPATH/packages.db")"

    ui_repo_complete "$PACKAGE_COUNT"
}

# ============================================================================
# Extract package information
# ============================================================================

extract_package_info() {
awk -v mirror="$1" '
BEGIN {
    FS=": ";
    OFS="|";
    url = "";
    description = "";
}

/^PACKAGE NAME:/ {
    package_name = $2;
    gsub(/^[ \t]+|[ \t]+$/, "", package_name);
}

/^PACKAGE LOCATION:/ {
    gsub(/^[ \t]+|[ \t]+$/, "", $2);
    gsub(/^\./, "", $2);
    url = mirror "/" $2 "/" package_name;
}

/^PACKAGE DESCRIPTION:/ {
    getline;
    description = $0;
    sub(/^.*: /, "", description);
}

/^$/ {
    if (package_name != "" && url != "") {
        print url, description;
    }

    url = "";
    description = "";
}

END {
    if (package_name != "" && url != "") {
        print url, description;
    }
}' "$2"
}

# ============================================================================
# Package search output
# ============================================================================

fn_pkg_search_print_out() {
    e_url="$1"
    e_filename="${e_url##*/}"
    e_base="${e_filename%.t?z}"
    e_release="${e_base##*-}"
    e_temp="${e_base%-*}"
    e_arch="${e_temp##*-}"
    e_temp="${e_temp%-*}"
    e_version="${e_temp##*-}"
    e_name="${e_temp%-*}"

    e_desc="$(echo "$2" | sed "s/$e_name //g")"

    status=""

    if [ -d "$DBPATH/installed/$e_name" ]; then
        if [ -f "$DBPATH/installed/$e_name/pkginfo" ]; then
            source "$DBPATH/installed/$e_name/pkginfo"

            if [ "$pkgver" == "$e_version" ] &&
               [ "$pkgrel" == "$e_release" ]; then
                status="installed"
            fi
        fi
    fi

    ui_search_package \
        "$e_name" \
        "$e_version-$e_release" \
        "$e_arch" \
        "$status"

    e_desc_no_braces="$(echo "$e_desc" | sed 's/[()]//g')"

    ui_detail "$e_desc_no_braces"
    printf "\n"
}

# ============================================================================
# Package search
# ============================================================================

fn_pkg_search() {
    if [[ $ARG ]]; then

        PKGSEARCH=$(grep -i "$ARG" "$DBPATH/packages.db")

        ui_search_start "$ARG"

        if [[ "$PKGSEARCH" != "" ]]; then

            count=0

            while read -r result; do

                urlR="$(echo "$result" | cut -d '|' -f1)"
                descriptionR="$(echo "$result" | cut -d '|' -f2)"

                fn_pkg_search_print_out \
                    "$urlR" \
                    "$descriptionR"

                count=$((count + 1))

            done <<< "$PKGSEARCH"

            ui_search_complete "$count"

        else
            ui_error "No results found for '$ARG'"
        fi

    else
        ui_warning "Please provide a search term."
    fi
}

# ============================================================================
# Get package match
# ============================================================================

fn_get_pkgmatch() {
    grep "/$1-[0-9]" "$DBPATH/packages.db" |
        head -1 |
        cut -d '|' -f1
}

# ============================================================================
# Check package match exists
# ============================================================================

fn_check_pkgmatch_exists() {
    unset MISSING

    LIST="$@"

    for ONE in $LIST; do

        PKGMATCH="$(fn_get_pkgmatch "$ONE")"

        if [[ $PKGMATCH == "" ]]; then
            MISSING+=("$ONE")
        fi
    done

    if [[ ${#MISSING[@]} != 0 ]]; then

        for i in "${MISSING[@]}"; do
            ui_error "Unable to locate package $i"
        done

        exit 1
    fi
}

# ============================================================================
# Package download
# ============================================================================

fn_pkg_download() {
    if [ $ARG ]; then

        PKGMATCH=$(fn_get_pkgmatch "$ARG")

        if [[ "$PKGMATCH" != "" ]]; then

            FILE=$(basename "$PKGMATCH")

            if [ ! -f "$CACHEDIR/$FILE" ]; then

                fn_download_file \
                    "$PKGMATCH" \
                    "$CACHEDIR" \
                    "$FILE"

            fi

            if [ ! -f "$CACHEDIR/$FILE" ]; then

                ui_error "$FILE download failed"
                exit 1
            fi

        else
            ui_error "Unable to locate package $ARG"
        fi
    fi
}

# ============================================================================
# Download all packages
# ============================================================================

fn_pkg_download_all() {
    fn_check_pkgmatch_exists $ARGD

    max_parallel=7
    current_jobs=0

    for pkg in $ARGD; do

        ARG="$pkg"

        fn_pkg_download &

        current_jobs=$((current_jobs + 1))

        if [ "$current_jobs" -ge "$max_parallel" ]; then
            wait -n
            current_jobs=$((current_jobs - 1))
        fi
    done

    wait
}

# ============================================================================
# Write package metadata
# ============================================================================

fn_write_metadata() {
    nv=$(echo "$1" |
        sed 's/\(.*\)-[^-]*-[^-]*$/\1/')

    pkgname="$(echo "$nv" |
        sed 's/-[^-]*$//')"

    pkgver="$(echo "$nv" |
        sed 's/.*-//')"

    pkgrel="$(echo "${1##*-}" |
        sed 's/.t.z//')"

    mkdir -p "$2/$DBPATH/installed/$pkgname"

    echo pkgname="$pkgname" \
        > "$2/$DBPATH/installed/$pkgname/pkginfo"

    echo pkgver="$pkgver" \
        >> "$2/$DBPATH/installed/$pkgname/pkginfo"

    echo pkgrel="$pkgrel" \
        >> "$2/$DBPATH/installed/$pkgname/pkginfo"

    tar -tvf "$1" |
        awk '!/^d/ {print $NF}' |
        grep -v "install/" |
        sed 's/^/\//' \
        > "$2/$DBPATH/installed/$pkgname/files"
}

# ============================================================================
# Extract single package
# ============================================================================

fn_pkg_extract() {
    if [[ "$ARG" != "" && -f "$ARG" ]]; then

        ui_heading "Extracting package"

        ui_install_package "$(basename "$ARG")"

        tar -xf "$ARG"

        ui_ok "extraction complete"

    else

        ui_error "Extraction failed: File not found or invalid."
        exit 1
    fi
}

# ============================================================================
# Extract all packages
# ============================================================================

fn_pkg_extract_all() {
    ui_heading "Extracting packages"

    for i in *.t?z; do

        [[ -e "$i" ]] || break

        ARG="$i"

        ui_install_package "$ARG"

        [ ! -d install ] && mkdir install

        tar -xf "$ARG" -C install

        if [ -f "install/install/doinst.sh" ]; then

            cd install &&
                sh ./install/doinst.sh 2>/dev/null

            cd "$OLDPWD" || exit
        fi

        fn_write_metadata "$ARG" install

        if [ -d install/install ]; then
            rm -r install/install
        fi

        ui_finished
    done

    ui_ok "extraction complete"
}

# ============================================================================
# Package post actions
# ============================================================================

fn_pkg_post_actions() {
    local ICONS
    local DESKTOP
    local GSETTINGS
    local FONTS

    ICONS=$(grep \
        /usr/share/icons/hicolor \
        "$DBPATH/installed/$pkgname/files" || true)

    DESKTOP=$(grep \
        /usr/share/applications \
        "$DBPATH/installed/$pkgname/files" || true)

    GSETTINGS=$(grep \
        /usr/share/glib-2.0/schemas \
        "$DBPATH/installed/$pkgname/files" || true)

    FONTS=$(grep \
        /usr/share/fonts/TTF \
        "$DBPATH/installed/$pkgname/files" || true)

    local file_paths=(
        "$ICONS"
        "$DESKTOP"
        "$GSETTINGS"
        "$FONTS"
    )

    for file_path in "${file_paths[@]}"; do

        if [ "$file_path" ]; then

            case "$file_path" in

                "$ICONS")
                    ui_install_action "Updating icon cache"

                    gtk-update-icon-cache \
                        /usr/share/icons/hicolor \
                        >/dev/null 2>&1

                    ui_install_action_done
                    ;;

                "$DESKTOP")
                    ui_install_action "Updating desktop database"

                    update-desktop-database \
                        >/dev/null 2>&1

                    ui_install_action_done
                    ;;

                "$GSETTINGS")
                    ui_install_action "Compiling GSettings schemas"

                    glib-compile-schemas \
                        /usr/share/glib-2.0/schemas \
                        >/dev/null 2>&1

                    ui_install_action_done
                    ;;

                "$FONTS")
                    ui_install_action "Updating font cache and directories"

                    fc-cache -f -s >/dev/null 2>&1
                    mkfontscale /usr/share/fonts/TTF >/dev/null 2>&1
                    mkfontdir /usr/share/fonts/TTF >/dev/null 2>&1

                    ui_install_action_done
                    ;;

            esac
        fi
    done
}

# ============================================================================
# Run install script
# ============================================================================

fn_run_install_script() {
    if [ -f "$1" ]; then

        cd / &&
            sh "$1" 2>/dev/null

        cd "$OLDPWD"
    fi
}

# ============================================================================
# Cleanup installation directory
# ============================================================================

fn_cleanup_install_directory() {
    if [ -d /install ]; then
        rm -r /install
    fi
}

# ============================================================================
# Install local package
# ============================================================================

fn_pkg_install_local() {
    if [[ "$ARG" != "" && -f "$ARG" ]]; then

        PACKAGE_FILE="$(basename "$ARG")"

        PACKAGE_BASE="${PACKAGE_FILE%.t?z}"
        PACKAGE_RELEASE="${PACKAGE_BASE##*-}"

        PACKAGE_TEMP="${PACKAGE_BASE%-*}"
        PACKAGE_ARCH="${PACKAGE_TEMP##*-}"

        PACKAGE_TEMP="${PACKAGE_TEMP%-*}"
        PACKAGE_VERSION="${PACKAGE_TEMP##*-}"

        PACKAGE_NAME="${PACKAGE_TEMP%-*}"

        ui_install_package "$PACKAGE_NAME"

        ui_install_detail \
            "$PACKAGE_VERSION-$PACKAGE_RELEASE · $PACKAGE_ARCH"

        tar -xf "$ARG" -C /

        fn_run_install_script "/install/doinst.sh"

        fn_write_metadata "$ARG" /

        fn_cleanup_install_directory

        fn_pkg_post_actions

    else

        ui_error "Installation failed: File not found or invalid."
        exit 1
    fi
}

# ============================================================================
# Install packages
# ============================================================================

fn_pkg_install() {
    LOCAL="false"

    for ONE in $ARGI; do

        if [ -f "$ONE" ]; then

            LOCAL="true"
            ARG="$ONE"

            NAME=$(echo "$ARG" |
                sed 's/\(.*\)-[^-]*-[^-]*$/\1/' |
                sed 's/-[^-]*$//')

            if [ -d "$DBPATH/installed/$NAME" ]; then

                ui_warning "$ARG is already installed"

            else

                fn_pkg_install_local
            fi
        fi
    done

    if [ "$LOCAL" = true ]; then
        exit 0
    fi

    fn_check_pkgmatch_exists "$ARGI"

    for ONE in $ARGI; do

        ARG="$ONE"

        if [ -d "$DBPATH/installed/$ARG" ]; then

            ui_warning "$ARG is already installed"
            exit 1
        fi
    done

    ARGD="$ARGI"

    ui_download_start

    fn_pkg_download_all

    ui_download_complete

    ui_install_start

    for ONE in $ARGI; do

        ARG="$ONE"

        PKGMATCH="$(fn_get_pkgmatch "$ARG")"

        FILE=$(basename "$PKGMATCH")

        if [ -f "$CACHEDIR/$FILE" ]; then

            ARG="$FILE"

            cd "$CACHEDIR" &&
                fn_pkg_install_local &&
                cd "$OLDPWD"
        fi
    done

    ui_install_complete
}

# ============================================================================
# Remove packages
# ============================================================================

fn_pkg_remove() {
    ui_remove_start

    for i in $ARGR; do

        if [ -f "$DBPATH/installed/$i/pkginfo" ]; then

            source "$DBPATH/installed/$i/pkginfo"

            ui_remove_package "$i"
            ui_remove_detail "$pkgver-$pkgrel"

            cat "$DBPATH/installed/$i/files" |
            while read -r file; do

                if [ -f "$file" ]; then
                    rm "$file"
                fi

            done

            fn_pkg_post_actions

            rm -r "$DBPATH/installed/$i"

            ui_finished

        else

            ui_warning "$i is not installed"
        fi
    done

    ui_remove_complete
}

# ============================================================================
# Clean cache
# ============================================================================

fn_pkg_clean_cache() {
    rm "$CACHEDIR"/* 2>/dev/null
}

# ============================================================================
# List installed packages
# ============================================================================

fn_pkg_list_installed() {
    local dir

    for dir in "$DBPATH"/installed/*/; do

        [ -f "$dir/pkginfo" ] || continue

        . "$dir/pkginfo"

        printf '%s %s-%s\n' \
            "$pkgname" \
            "$pkgver" \
            "$pkgrel"

    done | sort -k1,1
}

# ============================================================================
# Help
# ============================================================================

fn_pkg_show_help() {
    printf "\n"

    printf "  ${BOLD}${BRIGHT_WHITE}fetch2${RESET}"
    printf " ${DIM}Slackware package manager${RESET}\n\n"

    printf "  ${BOLD}${BRIGHT_CYAN}Usage${RESET}\n\n"

    printf "    %s <command> [arguments]\n\n" \
        "$(basename "$0")"

    printf "  ${BOLD}${BRIGHT_CYAN}Commands${RESET}\n\n"

    printf "    ${BRIGHT_CYAN}up${RESET}              Update repository database\n"
    printf "    ${BRIGHT_CYAN}sr${RESET} <term>       Search for packages\n"
    printf "    ${BRIGHT_CYAN}dl${RESET} <pkg...>     Download package(s)\n"
    printf "    ${BRIGHT_CYAN}xp${RESET} <file>       Extract a single package\n"
    printf "    ${BRIGHT_CYAN}xa${RESET}              Extract packages in current directory\n"
    printf "    ${BRIGHT_CYAN}it${RESET} <pkg...>     Install package(s)\n"
    printf "    ${BRIGHT_CYAN}rm${RESET} <pkg...>     Uninstall package(s)\n"
    printf "    ${BRIGHT_CYAN}cc${RESET}              Delete cached packages\n"
    printf "    ${BRIGHT_CYAN}li${RESET}              List installed packages\n"

    printf "\n"
}

# ============================================================================
# Arguments
# ============================================================================

case "$1" in

    up)
        fn_repo_update
        ;;

    sr)
        ARG="$2"
        fn_pkg_search
        ;;

    dl)
        shift
        ARGD="$@"
        fn_pkg_download_all
        ;;

    xp)
        ARG="$2"
        fn_pkg_extract
        ;;

    xa)
        fn_pkg_extract_all
        ;;

    it)
        shift
        ARGI="$@"
        fn_pkg_install
        ;;

    rm)
        shift
        ARGR="$@"
        fn_pkg_remove
        ;;

    cc)
        fn_pkg_clean_cache
        ;;

    li)
        fn_pkg_list_installed
        ;;

    *)
        fn_pkg_show_help
        ;;

esac
